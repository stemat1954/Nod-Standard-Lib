
page enumerator in AlphaByNod

type <t>enumerator  -- intrinsic, restricted
{{
	An enumerator is a restricted internal object used in
	the compilation of enum type definitions and select 
	expressions.

	enumerators are allocated in common storage and 
	automatically initialized at startup by the HNM using
	a compiler-generated mapping of <t> to int for every 
	enumerated item. The <t> values must be unique and rank-
	able using standard method :before?;
	
	At runtime, :enumerate is called to get a corresponding 
	integer value for a given object.
}}
{
	general 
	{
		enumerate ( <t> obj )( int );  -- output may be null
	}
}