
page enumerator in AlphaByNod

type <t>enumerator  -- intrinsic, restricted
{{
	An enumerator is a restricted internal object used by
	HNM SELECT.

	Enumerators are allocated in common storage and auto-
	matically initiated by the HNM at startup.
	
	<t> must have methods :begin( expr vex ) and 
	:before?( <t> )( bool ).

	Note: The HNM code generator emits an internal enum-
	eration that maps a select value expr (vex) into an
	select branch index. The internal enumeration is used 
	to initiate the enumerator.
}}
{
	general 
	{
		enumerate ( <t> obj )( int );  -- output may be null
	}
}