
page analog in AlphaByNod


type analog  -- intrinsic,restricted
{{
	An analog is an objectified proxy.

	An analog is a restricted type with no :begin method.

	An analog expression (proxy ref enclosed in square 
	brackets) creates an object and initializes it with 
	the proxy's instant	state.
	
	Analogs are anonymous, so they must be evaluated
	immediately. Thus, an analog expression always leads
	a method call:
	
		[~thing]:good?()( =bool )

		"good?( [~thing] )" 		

}}
{
	general
	{
		void? ()( bool );

		not_void? ()( bool );

		stale? ()( bool );

		not_stale? ()( bool );

		good? ()( bool );	-- "not_void? |and| not_stale?"
	}
}