page text_channel in StockByNod


{{
	A text channel is a synchronous i/o channel specialized
	for unicode	data transfer through a text mediator (editor).
	
	i/o text encoding is device dependent. The editor must be
	configured with compatible encoding.
	
	Text channels read and write without a time limit. A
	transfer was successful if an output error string is null.

	Writing is straightforward.  The base channel write 
	method is called in a loop until the whole message is 
	transferred. 

	Reading is more complicated. The base channel is read 
	one code unit at a time until a given count of char-
	acters is transferred, or until a given delimiter
	character is read.
}}


[page] routine
{
	read_channel_str ( sync_channel_reader reader [upd], editor ed [upd], int q )( string error )  -- q chars
	{
		int need:begin( q );
		loop
		{
			read_channel_chr( *reader, *ed )( error );
			if ( "not_null?( error )" ) escape;

			need:dec;
			if ( "need |=| zero" ) escape;
		}
	}

	read_channel_str ( sync_channel_reader reader [upd], editor ed [upd], unicode c )( string error )  -- delimited by c
	{
		ed:get_rp()( int mark ):set_rp_end;
		loop
		{
			read_channel_chr( *reader, *ed )( error );
			if ( "not_null?( error )" ) escape;

			ed:read()( unicode c2 );  -- last char
			if ( "c2 |=| c" ) escape;
		}
		ed:set_rp( mark ); -- start of new data
	}


	read_channel_chr ( sync_channel_reader reader [upd], editor ed [upd] )( string error )
	{
		ed:reserve;  -- one code point
		read_channel( *reader, *ed )( error );
		if ( "null?( error )" )
		{
			ed:reserve()( bool again );
			if ( again ) read_channel( *reader, *ed )( error );
		}
	}


	read_channel ( sync_channel_reader reader [upd], editor ed [upd] )( string error )
	{
		loop
		{
			reader:read( *ed )( channel_report report, string note );
			
			if ( "report |=| 'good'" ) escape;
			
			evaluate_transfer( report, note )( error );
			if ( "not_null?( error)" ) escape;
		}
	}

	write_channel ( sync_channel_writer writer [upd], editor ed [upd] )( string error )
	{
		loop
		{
			writer:write( *ed )( channel_report report, string note );
			
			if ( "report |=| 'good'" ) escape;
			
			evaluate_transfer( report, note )( error );
			if ( "not_null?( error)" ) escape;
		}
	}

	evaluate_transfer ( channel_report cr, string note [opt] )( string error )
	{
		select( cr )
		{
			value ( 'retry' );  -- partial transfer, no error

			value ( 'closed' )
			{
				error:begin( 'channel closed' );
			}

			value ( 'error' )
			{	
				editor ed:begin( 'channel error [' );
				if ( "not_null?( note )" ) ed:write( note );
				ed:write( ']' );
				ed:detach()( error );
			}

			else -- 'pending', 'busy', 'end', 'other'
			{
				editor:begin( 'unexpected channel report [' ):write( cr:use_token ):write( ']' ):detach()( error );
			}
		}
	}
}



type read_only_text_channel from sync_read_only_channel
{
	general
	{
		begin ( handle hch )
		{
			imo:as_base<sync_read_only_channel>:begin( hch );
		}

		read [upd]( editor ed [upd], int q )( string error )  -- q chars
		{
			read_channel_str( *imo:as_base<sync_channel_reader>, *ed, q )( error );
		}

		read [upd]( editor ed [upd], unicode c )( string error ) -- delimiter c
		{
			read_channel_str( *imo:as_base<sync_channel_reader>, *ed, c)( error );
		}
	}
}


type read_write_text_channel from sync_read_write_channel
{
	general
	{
		begin ( handle hch )
		{
			imo:as_base<sync_read_write_channel>:begin( hch );
		}

		read [upd]( editor ed [upd], int q )( string error ) -- q chars
		{
			read_channel_str( *imo:as_base<sync_channel_reader>, *ed, q )( error );
		}

		read [upd]( editor ed [upd], unicode c )( string error ) -- delimiter c
		{
			read_channel_str( *imo:as_base<sync_channel_reader>, *ed, c )( error );
		}

		write [upd]( editor ed [upd] )( string error )
		{
			write_channel( *imo:as_base<sync_channel_writer>, *ed )( error );
		}
	}
}



