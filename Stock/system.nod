
page system in StockByNod

--  SAMPLE IMPLEMENTATION (suitable for HelloWorld)


type system
{
	general method
	{
		begin 
		{
			imo.console:begin;  -- system console
		}

		use_console = console prox [eval,upd] ~c
		{
			~c -> imo.console;
		}
	}

	instance
	{
		console;
	}
}


common system sys:begin;	

